<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>栖</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>需要访问相册，才能把照片发到对话里、或者设置成壁纸和头像。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>需要相册权限，才能把图片保存到你的手机相册里。</string>
	<key>NSCameraUsageDescription</key>
	<string>需要相机权限，才能现场拍一张照片发出去。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>需要麦克风权限，才能按住说话把话转成文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你说的话转成文字填进输入框。识别在这台手机上完成，不会送去别的地方。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要本地网络权限，才能连上你自己电脑上跑的服务。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>他「查岗」的时候会看一眼你在哪儿、那边什么天气。默认只到城市，不给精确地址；也可以在「手机 → 查岗」里整个关掉。</string>

	<!-- 健康和待办。**三样都默认关着**，得在「设置 → 健康和待办」里一条条打开。
	     提醒事项和日历只要这几句说明就能用；
	     健康还要在 Xcode 里给 target 勾上 HealthKit 那项能力——
	     没勾的话读健康会失败，但 App 照样装得上、跑得起来，提醒事项那半不受影响。 -->
	<key>NSHealthShareUsageDescription</key>
	<string>你打开之后，他才看得到步数、睡眠、心率、锻炼和经期——为的是「你说累的时候他知道你昨晚只睡了四小时」。只读，不会往健康里写任何东西，也不会送出这台手机。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>你打开之后，他才看得到你的提醒事项。默认只读；「让他帮你记一笔」是另一个开关，而且只能新建，删不了也改不了。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>你打开之后，他才看得到接下来几天的日程——知道你三点要开会，就不会两点五十还拉着你说话。只读。</string>

	<!-- 灵动岛／锁屏上那条实时活动。没有这一项，ActivityKit 会直接拒绝。 -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- 允许在 App 没跑的时候由系统刷新那条活动的频率提示 -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bingbing.ayan.wake</string>
		<string>com.bingbing.ayan.tend</string>
	</array>

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
		<!-- 备用图标全部由 scripts/make-icons.sh 按 AppIcons/ 文件夹现生成，
		     这里不再写死任何一个。文件夹里放几张，App 里就能选几张。 -->
		<key>CFBundleAlternateIcons</key>
		<dict/>
	</dict>
</dict>
</plist>
